rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default-deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 256 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
        data.studyLevel in ['all', 'matric', 'tvet', 'undergraduate', 'honours', 'masters', 'phd', 'high_school', 'vocational'] &&
        data.marksPercentage is number && data.marksPercentage >= 0 && data.marksPercentage <= 100 &&
        data.emailRemindersEnabled is bool;
    }

    function isValidApplication(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.scholarshipId is string && data.scholarshipId.size() <= 128 &&
        data.scholarshipTitle is string && data.scholarshipTitle.size() <= 200 &&
        data.providerName is string && data.providerName.size() <= 150 &&
        data.status in ['saved', 'preparing', 'submitted', 'awarded', 'not_awarded'] &&
        data.deadline is string && data.deadline.size() <= 30 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('motivationLetter' in data) || (data.motivationLetter is string && data.motivationLetter.size() <= 5000));
    }

    function isValidReminder(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.email is string && data.email.size() <= 256 &&
        data.scholarshipId is string && data.scholarshipId.size() <= 128 &&
        data.scholarshipTitle is string && data.scholarshipTitle.size() <= 200 &&
        data.status in ['scheduled', 'delivered', 'dismissed'] &&
        data.deadline is string && data.deadline.size() <= 30;
    }

    match /users/{userId}/profile/info {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /users/{userId}/applications/{applicationId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(applicationId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(applicationId) &&
        isValidApplication(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidId(applicationId) &&
        isValidApplication(incoming(), userId) &&
        incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(applicationId);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(reminderId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(reminderId) &&
        isValidReminder(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidId(reminderId) &&
        isValidReminder(incoming(), userId) &&
        incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(reminderId);
    }

    match /scholarships/{scholarshipId} {
      allow get: if isValidId(scholarshipId);
      allow list: if true;
      allow write: if false;
    }
  }
}
